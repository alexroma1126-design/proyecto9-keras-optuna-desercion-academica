{
  "seed": 42,
  "tensorflow": "2.21.0",
  "architecture": [
    12,
    8,
    3
  ],
  "activation_hidden": "relu",
  "activation_output": "softmax",
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "loss": "sparse_categorical_crossentropy",
  "batch_size": 32,
  "epochs_max": 100,
  "early_stopping_patience": 12,
  "monitor": "val_loss",
  "evaluation_split": "validation",
  "test_not_used": true
}